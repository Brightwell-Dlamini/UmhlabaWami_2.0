# Umhlaba Wami — environment variables
# Copy this file to .env and fill in real values for local development.
# On Vercel: Project Settings → Environment Variables (Production + Preview).

# Required for production / Supabase-backed mode
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional
# Set to "false" to disable service worker registration
VITE_ENABLE_PWA=true
